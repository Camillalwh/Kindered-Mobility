import React, { useState, useEffect } from 'react';
import { Header } from './components/Header';
import { CockpitDashboard } from './components/CockpitDashboard';
import { ComplianceChecker } from './components/ComplianceChecker';
import { MedicalNeedAssessment } from './components/MedicalNeedAssessment';
import { TransitPathGuide } from './components/TransitPathGuide';
import { InfographicsLibrary } from './components/InfographicsLibrary';
import { CaregiverHub } from './components/CaregiverHub';
import { DeviceModelCatalog } from './components/DeviceModelCatalog';
import { EmergencySummonBar } from './components/EmergencySummonBar';
import { AccountPage } from './components/AccountPage';
import { TabType, TelemetryData, PMAModel } from './types';
import { LTA_STATUTORY_LIMITS, OFFICIAL_LTA_ASSETS } from './data/pmaData';

export default function App() {
  const [currentTab, setCurrentTab] = useState<TabType>('cockpit');

  // Realistic PMA Live Hardware Telemetry State
  const [telemetry, setTelemetry] = useState<TelemetryData>({
    speed: 4.2, // km/h
    maxSpeedLimit: LTA_STATUTORY_LIMITS.maxSpeedKmH, // 6.0 km/h
    isOverSpeed: false,
    batteryPercentage: 84,
    estimatedRangeKm: 21.8,
    batteryVoltage: 25.6,
    batteryTempC: 28,
    motorWatts: 118,
    currentAmps: 4.6,
    totalOdometerKm: 348.5,
    todayDistanceKm: 3.2,
    lightsFront: true,
    lightsRear: true,
    emergencyBrakeEngaged: false,
    currentPath: 'footpath',
    driveMode: 'standard',
    locationName: 'Bedok North Ave 3, Footpath to MRT',
    lat: 1.3241,
    lng: 103.9312,
  });

  // Minor telemetry jitter simulation to feel like authentic live hardware
  useEffect(() => {
    const timer = setInterval(() => {
      setTelemetry((prev) => {
        if (prev.driveMode === 'transit-stow') {
          return { ...prev, speed: 0, motorWatts: 0, currentAmps: 0.1 };
        }
        // Micro fluctuation if moving
        if (prev.speed > 0) {
          const delta = (Math.random() - 0.5) * 0.1;
          const newSpeed = Math.min(
            prev.driveMode === 'eco' ? 4.0 : 6.0,
            Math.max(0.5, prev.speed + delta)
          );
          return {
            ...prev,
            speed: Number(newSpeed.toFixed(1)),
            motorWatts: Math.round(newSpeed * 28 + 15),
            currentAmps: Number((newSpeed * 1.1 + 0.3).toFixed(1)),
          };
        }
        return prev;
      });
    }, 2500);

    return () => clearInterval(timer);
  }, []);

  const handleSelectModelForCompliance = (model: PMAModel) => {
    setCurrentTab('compliance');
  };

  return (
    <div className="min-h-screen bg-[#F8FAFC] text-[#1E293B] flex flex-col font-sans selection:bg-[#0D9488] selection:text-white pb-12">
      {/* Top Header Chrome */}
      <Header
        currentTab={currentTab}
        onTabChange={setCurrentTab}
        telemetry={telemetry}
      />

      {/* Main Content Area */}
      <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-6">
        {currentTab === 'cockpit' && (
          <CockpitDashboard
            telemetry={telemetry}
            setTelemetry={setTelemetry}
            onOpenCompliance={() => setCurrentTab('compliance')}
            onOpenInfographics={() => setCurrentTab('infographics')}
          />
        )}

        {currentTab === 'compliance' && (
          <ComplianceChecker />
        )}

        {currentTab === 'medical-cmn' && (
          <MedicalNeedAssessment />
        )}

        {currentTab === 'transit-rules' && (
          <TransitPathGuide />
        )}

        {currentTab === 'infographics' && (
          <InfographicsLibrary />
        )}

        {currentTab === 'caregiver' && (
          <CaregiverHub telemetry={telemetry} />
        )}

        {currentTab === 'catalog' && (
          <DeviceModelCatalog
            onSelectForCompliance={handleSelectModelForCompliance}
          />
        )}

        {currentTab === 'account' && (
          <AccountPage telemetry={telemetry} />
        )}
      </main>

      {/* Official Singapore Government & LTA Footer Citation */}
      <footer className="border-t border-slate-200 bg-white mt-12 py-6 px-4 text-xs text-slate-500 mb-16">
        <div className="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
          <div className="flex items-center space-x-3">
            <img
              src={OFFICIAL_LTA_ASSETS.govSgLogo}
              alt="Singapore Government"
              className="h-6 w-auto object-contain"
              onError={(e) => { (e.currentTarget as HTMLElement).style.display = 'none'; }}
            />
            <img
              src={OFFICIAL_LTA_ASSETS.ltaLogo}
              alt="LTA Logo"
              className="h-6 w-auto object-contain"
              onError={(e) => { (e.currentTarget as HTMLElement).style.display = 'none'; }}
            />
            <span className="font-semibold text-slate-700">
              Kinetic Dignity • Singapore Personal Mobility Aids Framework
            </span>
          </div>

          <div className="flex flex-wrap items-center gap-4 text-xs">
            <a
              href={OFFICIAL_LTA_ASSETS.activeMobilityActUrl}
              target="_blank"
              rel="noopener noreferrer"
              className="hover:text-teal-700 hover:underline"
            >
              LTA Active Mobility Act
            </a>
            <span>•</span>
            <a
              href="https://onemotoring.lta.gov.sg"
              target="_blank"
              rel="noopener noreferrer"
              className="hover:text-teal-700 hover:underline"
            >
              OneMotoring Portal
            </a>
            <span>•</span>
            <a
              href={OFFICIAL_LTA_ASSETS.amapReportPdf}
              target="_blank"
              rel="noopener noreferrer"
              className="hover:text-teal-700 hover:underline"
            >
              AMAP Report PDF
            </a>
            <span>•</span>
            <span>Speed Limit: 6 km/h</span>
          </div>
        </div>
      </footer>

      {/* Sticky Fixed Bottom Emergency Summon Bar */}
      <EmergencySummonBar telemetry={telemetry} />
    </div>
  );
}
